# Covnant — environment template. Copy to .env.local and fill in.
# Supabase persistence activates once BOTH variables are set; without them
# the platform runs on the in-memory registry fallback.

# Public anon credential (RLS-enforcing client role). Reserved for the v2
# authentication layer: current deny-all-to-anon policies in
# supabase/migrations/0001_covenant_init.sql block anon reads by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin console gate — the shared secret POST /api/admin/login exchanges for
# the signed admin session cookie. Unset = the admin console and every
# /api/admin route fail closed (503 admin_not_configured), never open.
# Server-side only: never exposed to the client, never logged; set the real
# value in Vercel.
ADMIN_DASHBOARD_PASSWORD=

# The Don dev-seed — set to 1 ONLY in local dev / the e2e harness / preview
# deployments of the dashboard branch. Boots the seeded in-memory Don store
# at server start (deterministic Nova Reign demo holder: royalties, a
# pending release, in-flight payouts) and serves the live dashboard
# resolver from it. NEVER set this in production — it swaps the session-
# bound identity for the demo persona.
#
# The DEMO DOOR needs no flag: a SESSIONLESS GET of /dashboard renders the
# same seeded demo (marked with the DEMO DATA badge) in every environment —
# production included — over a dedicated store that never touches the
# session-bound persistence seam. Signed-in sessions always get real,
# session-bound data.
DON_DEV_SEED=

# Identifier-engine signing secrets (audit S1/S2 — the former public dev
# defaults are removed; both secrets are required in EVERY environment,
# local dev included).
#   JWT_SECRET     — verifies Bearer tokens on the identifier-engine
#                    batch-ingest API (src/lib/server/identifierAuth.ts).
#   WEBHOOK_SECRET — verifies telemetry-webhook HMAC signatures
#                    (src/app/api/v1/webhooks/telemetry-stream).
# Both FAIL CLOSED when unset: the batch-ingest route and the telemetry
# webhook reject every request until real values are set. Generate long
# random values (e.g. `openssl rand -hex 32`), never reuse one for the
# other, and set the real values in Vercel.
JWT_SECRET=
WEBHOOK_SECRET=
