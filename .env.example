# Covnant — environment template. Copy to .env.local and fill in.
# Supabase persistence activates once BOTH variables are set; without them
# the platform runs on the in-memory registry fallback.

# Public anon credential (RLS-enforcing client role). Reserved for the v2
# authentication layer: current deny-all-to-anon policies in
# supabase/migrations/0001_covenant_init.sql block anon reads by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin console gate — the shared secret POST /api/admin/login exchanges for
# the signed admin session cookie. Unset = the admin console and every
# /api/admin route fail closed (503 admin_not_configured), never open.
# Server-side only: never exposed to the client, never logged; set the real
# value in Vercel.
ADMIN_DASHBOARD_PASSWORD=
