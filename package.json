    "next": "15.5.25",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "4.7.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "6.0.3",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "29.1.1",
